[Unit]
Description=Tectonic Engine v3 control bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=tectonic
WorkingDirectory=/opt/tectonic-engine-v3
ExecStart=/opt/tectonic-engine-v3/.venv/bin/python -m v3.main
Restart=on-failure
RestartSec=10
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
