# Required at boot
V3_BOT_TOKEN=your_botfather_token_here

# Required when linking Pyrogram worker accounts
V3_API_ID=12345678
V3_API_HASH=your_telegram_api_hash_here

# Optional: comma-separated Telegram numeric user IDs
V3_ADMIN_IDS=
V3_BILLING_BYPASS_IDS=

# Optional: payment & support display settings
V3_BKASH_NAGAD_NUMBER=01XXXXXXXXX
V3_BINANCE_PAY_ID=0000000000
V3_SUPPORT_URL=https://t.me/your_support_handle

# Optional: proxy & storage paths
V3_TELEGRAM_PROXY=
V3_DATA_DIR=data
V3_DB_PATH=data/v3.db
